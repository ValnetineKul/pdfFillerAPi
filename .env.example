# Local Docker Postgres, or Neon (use ?sslmode=require for Neon).
DATABASE_URL=postgres://pdffiller:pdffiller@localhost:5432/pdffiller?sslmode=disable
# Optional Neon pooler URL (serverless / many short connections).
# DATABASE_URL_POOLED=postgresql://USER:PASS@HOST-pooler/neondb?sslmode=require

CHATPLACE_WEBHOOK_SECRET=replace-me
# ChatPlace MCP key (Settings → MCP) with write access to chats. Sends the login and password to Instagram.
# This is not the webhook secret.
CHATPLACE_API_KEY=
# CHATPLACE_API_URL=https://mcp.chatplace.io/mcp
# Link included in the account message. The page where the customer logs in.
APP_LOGIN_URL=http://localhost:5173
COOKIE_SECURE=0
SEED_LOGIN=anna
SEED_PASSWORD=password1
SEED_CREDITS=5
# Leave ADDR empty on Railway so the process listens on Railway's PORT.
ADDR=:8080
